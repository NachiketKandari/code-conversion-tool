# Secrets / encrypted artifacts (never commit)
secret.txt.*
filecrypt
*.dec
*.enc

# Go
*.exe
*.test
*.out
vendor/
bin/

# Tool runtime artifacts (never commit: corpus may be proprietary, logs/captures may hold sensitive data — R6)
tux/
# batch→python reference corpus (proprietary-shaped, local only — PRD-2026-09-08)
batchExamples/
# batchpy generated modules (derived from the gitignored corpus)
python_out/
# real-service corpus: original .pc sources + their nav reference conversions + generic snippets (local only)
tuxExamples/
examples/
# discovery drafts: generated from the local corpus, edited locally (tagged mappings may still carry corpus hints)
mappings/
stuff-i-want-checked/
# synthetic regression fixtures (tux .pc / converted go trees / python goldens): local only,
# purged from history 2026-09-09 — tests run against the local copy, no example bytes in the repo
testdata/
conversion_logs/
/tuxgo
.tuxgo.yaml
# local real-corpus endpoint mapping (proprietary query names)
nav.mapping.yaml
.tuxgo/

# Docs stay local (PRDs/design notes are not part of the code commit) — the root
# README ships (anchored, so docs/ or prd/ readmes stay local)
*.md
!/README.md

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/
